{
  "$comment": "Single source for harness limits and thresholds. WORKFLOW.md §2, §5.2 and §6 cite this file. Read by generator/scripts/awarelib.py.",
  "base_branch": "main",
  "generate_model": "TBD-at-P3",
  "generate_model_fallback": "TBD-at-P3",
  "self_repair_max": 3,
  "apps": {
    "android": {
      "dir": "clients/android",
      "platform_spec": "spec/platform/android.md",
      "conventions": "generator/conventions/android.md",
      "build": "TBD-at-P3 (expected: ./gradlew assembleDebug)",
      "test": "TBD-at-P3 (expected: ./gradlew testDebugUnitTest)"
    },
    "web": {
      "dir": "clients/web",
      "platform_spec": "spec/platform/web.md",
      "conventions": "generator/conventions/web.md",
      "build": "TBD-at-P3 (expected: npm ci && npm run build)",
      "test": "TBD-at-P3 (expected: npm test)"
    }
  },
  "limits": {
    "rev_opus_changed_lines": 400,
    "snapshot_split_lines": 2000,
    "caps": {
      "review_rounds": 3,
      "qa_fix": 2,
      "accept_reopen": 1,
      "g1_rejections": 2,
      "spec_reopen": 2,
      "regen_check": 2,
      "env_retry": 1
    }
  },
  "count_lines": {
    "$comment": "Excluded from changed_lines (WORKFLOW §6.2). Binary files (numstat '-') are always excluded.",
    "exclude_names": [
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      "npm-shrinkwrap.json",
      "gradle.lockfile",
      "poetry.lock",
      "Pipfile.lock",
      "uv.lock",
      "Cargo.lock",
      "gradlew",
      "gradlew.bat",
      ".generated"
    ],
    "exclude_globs": [
      "gradle/wrapper/*",
      "*/gradle/wrapper/*",
      "*.lockfile"
    ]
  },
  "headers": {
    "$comment": "check_headers.py: GENERATED header marker and which files must carry it.",
    "manifest": ".generated",
    "marker": "GENERATED by the Aware harness",
    "scan_lines": 5,
    "comment_extensions": [
      ".kt",
      ".kts",
      ".java",
      ".gradle",
      ".xml",
      ".pro",
      ".properties",
      ".toml",
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".css",
      ".scss",
      ".html",
      ".py",
      ".sh",
      ".yml",
      ".yaml"
    ],
    "ignore_dirs": [
      "node_modules",
      "build",
      ".gradle",
      "dist",
      ".idea",
      "coverage",
      "test-results",
      "playwright-report"
    ],
    "header_text": "GENERATED by the Aware harness from spec {spec_version} — do not edit; change the spec and regenerate."
  },
  "trace": {
    "$comment": "check_trace.py (E-PM-1, E-PM-3, E-QA-1). A rule is a bold spec id matching spec_id_regex that opens a list item or table row containing must_keyword. file_apps (by file name) and default_apps say which apps must cover a rule; an [apps: a, b] marker on the definition line overrides.",
    "file": "docs/product/TRACEABILITY.md",
    "spec_dir": "spec",
    "spec_id_regex": "\\b(?:CORE|EXT|PLAT)(?:-[A-Z]+)?-\\d{3}\\b",
    "must_keyword": "MUST",
    "scope_regex": "^(core|platform:[a-z0-9-]+)$",
    "coverage_apps": ["android", "web", "server"],
    "default_apps": ["android", "web", "server"],
    "file_apps": {
      "client-behavior.md": ["android", "web"],
      "server-behavior.md": ["server"],
      "android.md": ["android"],
      "web.md": ["web"],
      "test-hooks.md": ["android", "web"]
    }
  },
  "regen": {
    "$comment": "regen_check.py (S6b, E-PIPE-1). {app} and {model} are substituted.",
    "generate_cmd": "claude -p \"/generate {app}\" --model {model}",
    "worktree_dir": ".work/wt",
    "report_dir": ".work/regen"
  },
  "commits": {
    "$comment": "lint_commits.py (E-PIPE-3), trailers per WORKFLOW §8.",
    "agent_author_regex": "^Aware Agent \\((?P<role>[A-Z]+)/(?P<model>[^)]+)\\)$",
    "agent_author_prefix": "Aware Agent",
    "required_trailers": [
      "Area",
      "Boundary",
      "Authored-By-Role",
      "Agent",
      "Model"
    ],
    "stage_roles": [
      "PM",
      "TL",
      "DEV",
      "REV",
      "QA"
    ],
    "feature_stage_regex": "^(S[0-7]b?|G[0-2])$",
    "gate_stage_regex": "^G[0-2]$",
    "boundary_values": [
      "generated",
      "maintained"
    ],
    "role_values": [
      "human",
      "agent"
    ],
    "refs_regex": "^OM-\\d{4}$",
    "exclusive_dirs": [
      "spec/",
      "clients/"
    ],
    "generated_dir": "clients/",
    "generated_subject_regex": "^regen\\([a-z0-9-]+\\): "
  },
  "preflight": {
    "timeout_s": 20
  },
  "generate": {
    "$comment": "Values render_prompt.py --generate fills into generator/prompts/generate.md. {app} is substituted.",
    "prompt": "generator/prompts/generate.md",
    "spec_index": "spec/README.md",
    "spec_version_regex": "\\*\\*Version:\\*\\*\\s*(\\d+\\.\\d+\\.\\d+)",
    "spec_dirs": [
      "spec/core/",
      "spec/scenarios/",
      "spec/extensions/"
    ],
    "platform_shared": [
      "spec/platform/test-hooks.md",
      "spec/platform/client-snapshot.schema.json"
    ],
    "templates_dir": "generator/templates/{app}/",
    "plan_out": ".work/generate/{app}/plan.md",
    "manifest_schema": "generator/schemas/manifest.schema.json"
  },
  "prompt_lint": {
    "$comment": "lint_prompts.py (E-EVOL-1): feature nouns must not appear in generator prompts outside fenced blocks whose info string contains example_fence_word.",
    "paths": [
      "generator/prompts",
      ".claude/commands/generate.md"
    ],
    "example_fence_word": "example",
    "suffixes": [
      "s",
      "es",
      "d",
      "ed",
      "ing"
    ],
    "denylist": [
      "login",
      "logout",
      "signin",
      "sign-in",
      "chat",
      "message",
      "messaging",
      "queue",
      "offline",
      "reconnect",
      "flush",
      "inbox",
      "outbox",
      "conversation",
      "reaction",
      "attachment",
      "alice",
      "bob",
      "recipient",
      "sender",
      "contact",
      "emoji",
      "typing indicator"
    ]
  }
}
