{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,32}$",
      "description": "Canonical user name (CORE-NAME-002)."
    },
    "name_input": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "User name as accepted on input (CORE-NAME-001)."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Message id, lowercase UUID v4 (CORE-ENV-002)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[048]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "description": "UTC instant, exactly three fraction digits, uppercase Z, real Gregorian calendar date and time (no leap second) (CORE-HTTP-007). Cases: cases/timestamp.json."
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "description": "Envelope type (CORE-ENV-004)."
    },
    "epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Server epoch (CORE-EPOCH-001)."
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "Capability id (CORE-SESSION-002)."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload": {
      "type": "object",
      "description": "Opaque for non-core types; core types validated by core_types in index.json (CORE-ENV-005)."
    }
  }
}
