{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,32}$",
      "description": "Canonical user name (CORE-NAME-002)."
    },
    "name_input": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "User name as accepted on input (CORE-NAME-001)."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Message id, lowercase UUID v4 (CORE-ENV-002)."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "UTC, millisecond precision (CORE-HTTP-007)."
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "description": "Envelope type (CORE-ENV-004)."
    },
    "epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Server epoch (CORE-EPOCH-001)."
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "Capability id (CORE-SESSION-002)."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload": {
      "type": "object",
      "description": "Opaque for non-core types; core types validated by core_types in index.json (CORE-ENV-005)."
    }
  }
}
