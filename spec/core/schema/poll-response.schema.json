{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poll-response.schema.json",
  "title": "E4 response 200 (CORE-POLL-003, -004)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "epoch",
    "messages",
    "next_cursor",
    "has_more"
  ],
  "properties": {
    "epoch": {
      "$ref": "common.schema.json#/$defs/epoch"
    },
    "messages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "envelope.schema.json"
      }
    },
    "next_cursor": {
      "$ref": "common.schema.json#/$defs/cursor"
    },
    "has_more": {
      "type": "boolean"
    }
  }
}
