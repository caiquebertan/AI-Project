{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "send-response.schema.json",
  "title": "E3 response 200/201 (CORE-MSG-001)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "seq",
    "accepted_at",
    "epoch"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "seq": {
      "$ref": "common.schema.json#/$defs/seq"
    },
    "accepted_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "epoch": {
      "$ref": "common.schema.json#/$defs/epoch"
    }
  }
}
