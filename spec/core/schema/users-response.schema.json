{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "users-response.schema.json",
  "title": "E5 response 200 (CORE-CAP-003)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "users"
  ],
  "properties": {
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "capabilities"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "capabilities": {
            "$ref": "common.schema.json#/$defs/capabilities"
          }
        }
      }
    }
  }
}
