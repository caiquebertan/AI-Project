{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "client-snapshot.schema.json",
  "title": "Client state snapshot read by test hooks (PLAT-HOOK-006..008); test contract, not wire protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user",
    "connection",
    "offline_toggle",
    "network_available",
    "epoch",
    "cursor",
    "outbox",
    "messages"
  ],
  "properties": {
    "user": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9_-]{1,32}$",
      "description": "Canonical identity; null when logged out."
    },
    "connection": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "offline",
        "connecting",
        "online",
        null
      ],
      "description": "CORE-CONN-003; null when logged out."
    },
    "offline_toggle": {
      "type": "boolean"
    },
    "network_available": {
      "type": "boolean"
    },
    "epoch": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{16}$"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    },
    "outbox": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "seq",
          "from",
          "to",
          "text",
          "state",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "seq": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "text": {
            "type": "string"
          },
          "state": {
            "enum": [
              "pending",
              "sent",
              "received",
              "failed"
            ]
          },
          "created_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
          }
        }
      }
    }
  }
}
